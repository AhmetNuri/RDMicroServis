# ============================================================
# DISTRIBUTED MINI COMMERCE PLATFORM - ENVIRONMENT VARIABLES
# ============================================================

# PostgreSQL - Auth Service
POSTGRES_AUTH_HOST=postgres-auth
POSTGRES_AUTH_PORT=55432
POSTGRES_AUTH_DB=authdb
POSTGRES_AUTH_USER=authuser
POSTGRES_AUTH_PASSWORD=Auth@Str0ng!Pass

# PostgreSQL - Analytics Service
POSTGRES_ANALYTICS_HOST=postgres-analytics
POSTGRES_ANALYTICS_PORT=55433
POSTGRES_ANALYTICS_DB=analyticsdb
POSTGRES_ANALYTICS_USER=analyticsuser
POSTGRES_ANALYTICS_PASSWORD=Analytics@Str0ng!Pass

# PostgreSQL - Audit Service
POSTGRES_AUDIT_HOST=postgres-audit
POSTGRES_AUDIT_PORT=55435
POSTGRES_AUDIT_DB=auditdb
POSTGRES_AUDIT_USER=audituser
POSTGRES_AUDIT_PASSWORD=Audit@Str0ng!Pass

# PostgreSQL - Payment Service (Laravel)
POSTGRES_PAYMENT_HOST=postgres-payment
POSTGRES_PAYMENT_PORT=55434
POSTGRES_PAYMENT_DB=paymentdb
POSTGRES_PAYMENT_USER=paymentuser
POSTGRES_PAYMENT_PASSWORD=Payment@Str0ng!Pass

# MSSQL - Order Service
MSSQL_ORDER_HOST=mssql-order
MSSQL_ORDER_PORT=11433
MSSQL_ORDER_DB=orderdb
MSSQL_SA_PASSWORD=Order@Str0ng!Pass1

# MongoDB - Notification Service
MONGO_NOTIFICATION_HOST=mongo-notification
MONGO_NOTIFICATION_PORT=27017
MONGO_NOTIFICATION_DB=notificationdb
MONGO_NOTIFICATION_USER=notifuser
MONGO_NOTIFICATION_PASSWORD=Notif@Str0ng!Pass

# MongoDB - Product Service
MONGO_PRODUCT_HOST=mongo-product
MONGO_PRODUCT_PORT=27018
MONGO_PRODUCT_DB=productdb
MONGO_PRODUCT_USER=productuser
MONGO_PRODUCT_PASSWORD=Product@Str0ng!Pass

# MongoDB - Inventory Service
MONGO_INVENTORY_HOST=mongo-inventory
MONGO_INVENTORY_PORT=27019
MONGO_INVENTORY_DB=inventorydb
MONGO_INVENTORY_USER=inventoryuser
MONGO_INVENTORY_PASSWORD=Inventory@Str0ng!Pass

# Elasticsearch
ELASTICSEARCH_HOST=elasticsearch
ELASTICSEARCH_PORT=19200
ELASTICSEARCH_PASSWORD=Elastic@Str0ng!Pass

# Redis
REDIS_HOST=redis
