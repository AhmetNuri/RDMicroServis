ZOOKEEPER_PORT=12181

# RabbitMQ
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=15672
RABBITMQ_MANAGEMENT_PORT=15673
RABBITMQ_USER=rabbituser
RABBITMQ_PASSWORD=Rabbit@Str0ng!Pass

# JWT
JWT_SECRET=SuperSecret@JWT!Key2025MiniCommerce
JWT_EXPIRES_IN=3600
JWT_REFRESH_EXPIRES_IN=86400

# Service Ports (internal container port 8080, mapped externally)
AUTH_SERVICE_PORT=8001
ORDER_SERVICE_PORT=8002
NOTIFICATION_SERVICE_PORT=8003
AUDIT_SERVICE_PORT=8004
ANALYTICS_SERVICE_PORT=8005
SEARCH_INDEXER_PORT=8006
PRODUCT_SERVICE_PORT=8007
PAYMENT_SERVICE_PORT=8008
INVENTORY_SERVICE_PORT=8009

# Frontend Ports
SHOP_WEB_PORT=3001
LANDING_WEB_PORT=3002
ADMIN_PORTAL_PORT=4201
OPERATIONS_PANEL_PORT=4202

# Nginx API Gateway Port
NGINX_GATEWAY_PORT=8080

# Observability
PROMETHEUS_PORT=19090
GRAFANA_PORT=13000
GRAFANA_ADMIN_PASSWORD=Grafana@Str0ng!Pass
LOKI_PORT=13100
TEMPO_PORT=13200
TEMPO_GRPC_PORT=14320
KIBANA_PORT=15601
OTEL_COLLECTOR_GRPC_PORT=14317
OTEL_COLLECTOR_HTTP_PORT=14318

# CORS
CORS_ORIGINS=http://localhost:3001,http://localhost:3002,http://localhost:4201,http://localhost:4202,http://localhost:8080

# Kibana encryption
KIBANA_ENCRYPTION_KEY=kibana-xsrf-token-32-chars-min!!
